# Salin file ini menjadi .env lalu ganti nilainya (JANGAN commit .env)
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# Rahasia untuk menandatangani JWT (HS256)
JWT_SECRET=ganti-dengan-string-acak-panjang
# Rahasia yang ditambahkan gateway ke header X-Gateway-Secret
GATEWAY_SECRET=ganti-dengan-string-acak-lain

# Kredensial Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-secret-service

# Jam akses ubah/finalisasi nilai: boleh jika START <= jam < END
# (ubah untuk demo, mis. START=0 END=0 berarti selalu ditolak)
ACCESS_HOUR_START=7
ACCESS_HOUR_END=21
ACCESS_TZ=Asia/Jakarta

# Lokasi database SQLite (relatif terhadap root project)
DB_PATH=db/app.db
